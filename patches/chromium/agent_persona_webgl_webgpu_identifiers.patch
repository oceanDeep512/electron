diff --git a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
--- a/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
+++ b/third_party/blink/renderer/modules/webgpu/gpu_adapter_info.cc
@@ -4,11 +4,49 @@
 
 #include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info.h"
 
+#include "base/command_line.h"
+#include "base/no_destructor.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_memory_heap_info.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_subgroup_matrix_config.h"
 
 namespace blink {
 
+struct AgentWebGPUStrings {
+  String vendor;
+  String architecture;
+  String device;
+  String description;
+};
+
+AgentWebGPUStrings ReadAgentWebGPUStrings() {
+  AgentWebGPUStrings values;
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  values.vendor = String::FromUtf8(
+      command_line->GetSwitchValueASCII("electron-agent-webgpu-vendor"));
+  values.architecture = String::FromUtf8(command_line->GetSwitchValueASCII(
+      "electron-agent-webgpu-architecture"));
+  values.device = String::FromUtf8(
+      command_line->GetSwitchValueASCII("electron-agent-webgpu-device"));
+  values.description = String::FromUtf8(
+      command_line->GetSwitchValueASCII("electron-agent-webgpu-description"));
+  return values;
+}
+
+const String& AgentWebGPUOverride(const char* switch_name) {
+  // Function-local static initialization runs once, including across threads.
+  // NoDestructor keeps the strings for the process lifetime.
+  static base::NoDestructor<AgentWebGPUStrings> values(ReadAgentWebGPUStrings());
+  const std::string name(switch_name);
+  if (name == "electron-agent-webgpu-vendor")
+    return values->vendor;
+  if (name == "electron-agent-webgpu-architecture")
+    return values->architecture;
+  if (name == "electron-agent-webgpu-device")
+    return values->device;
+  return values->description;
+}
+
