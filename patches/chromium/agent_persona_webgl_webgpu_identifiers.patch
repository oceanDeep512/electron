@@ -4,11 +4,44 @@
 
 #include "third_party/blink/renderer/modules/webgpu/gpu_adapter_info.h"
 
+#include "base/command_line.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_memory_heap_info.h"
 #include "third_party/blink/renderer/modules/webgpu/gpu_subgroup_matrix_config.h"
 
 namespace blink {
 
+const String& AgentWebGPUOverride(const char* switch_name) {
+  // The command line does not change. A process-lifetime string can be
+  // returned by the const getters. Empty means no override.
+  static String vendor;
+  static String architecture;
+  static String device;
+  static String description;
+  static bool ready = false;
+  if (!ready) {
+    vendor = String::FromUtf8(base::CommandLine::ForCurrentProcess()
+                                  ->GetSwitchValueASCII(
+                                      "electron-agent-webgpu-vendor"));
+    architecture = String::FromUtf8(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "electron-agent-webgpu-architecture"));
+    device = String::FromUtf8(base::CommandLine::ForCurrentProcess()
+                                  ->GetSwitchValueASCII(
+                                      "electron-agent-webgpu-device"));
+    description = String::FromUtf8(
+        base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+            "electron-agent-webgpu-description"));
+    ready = true;
+  }
+  if (std::string(switch_name) == "electron-agent-webgpu-vendor")
+    return vendor;
+  if (std::string(switch_name) == "electron-agent-webgpu-architecture")
+    return architecture;
+  if (std::string(switch_name) == "electron-agent-webgpu-device")
+    return device;
+  return description;
+}
+
 GPUAdapterInfo::GPUAdapterInfo(const String& vendor,
                                const String& architecture,
