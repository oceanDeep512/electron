 namespace {
 
+String AgentWebGLString(const char* switch_name, const String& fallback) {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(switch_name);
+  if (value.empty())
+    return fallback;
+  String override_value = String::FromUtf8(value);
+  return override_value.IsNull() ? fallback : override_value;
+}
