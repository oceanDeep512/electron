Date: Wed, 11 Nov 2026 19:10:00 +0000
Subject: [electron] perturb canvas readback without changing the displayed bitmap

An agent persona passes these values on the renderer command line. The
switches are absent unless that renderer belongs to a persona session, so
other processes keep Chromium's behavior. Nothing here is compiled in this
change.

diff --git a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
--- a/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
+++ b/third_party/blink/renderer/platform/graphics/image_data_buffer.cc
@@ -32,6 +32,10 @@
 
 #include "third_party/blink/renderer/platform/graphics/image_data_buffer.h"
 
+#include <cstring>
+#include <vector>
+
+#include "base/command_line.h"
 #include "base/compiler_specific.h"
 #include "base/logging.h"
 #include "base/memory/ptr_util.h"
@@ -46,6 +50,45 @@
 
 namespace blink {
 
+
+void PerturbCanvasBytes(uint8_t* data, size_t size) {
+  const std::string seed =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-canvas-seed");
+  if (seed.empty() || !data || size == 0)
+    return;
+  uint32_t hash = 2166136261u;
+  for (unsigned char c : seed)
+    hash = (hash ^ c) * 16777619u;
+  for (size_t i = 0; i < size; i += 64) {
+    uint32_t mixed = (hash ^ static_cast<uint32_t>(i) ^ data[i]) * 0x9E3779B1u;
+    if (mixed & 1u) {
+      data[i] = data[i] == 255 ? static_cast<uint8_t>(254)
+                               : static_cast<uint8_t>(data[i] + 1);
+    } else {
+      data[i] = data[i] == 0 ? static_cast<uint8_t>(1)
+                             : static_cast<uint8_t>(data[i] - 1);
+    }
+  }
+}
+
+
+SkPixmap PersonaReadbackPixmap(const SkPixmap& pixmap,
+                               std::vector<uint8_t>* storage) {
+  const std::string seed =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-canvas-seed");
+  if (seed.empty() || !pixmap.addr())
+    return pixmap;
+  const size_t size = pixmap.computeByteSize();
+  if (size == 0)
+    return pixmap;
+  storage->resize(size);
+  memcpy(storage->data(), pixmap.addr(), size);
+  PerturbCanvasBytes(storage->data(), storage->size());
+  return SkPixmap(pixmap.info(), storage->data(), pixmap.rowBytes());
+}
+
 ImageDataBuffer::ImageDataBuffer(scoped_refptr<StaticBitmapImage> image) {
   if (!image)
     return;
@@ -147,7 +190,9 @@
                                   Vector<unsigned char>* encoded_image) const {
   std::optional<skhdr::Metadata> hdr_metadata =
       ImageEncoderUtils::ToSkHdrMetadata(hdr_metadata_);
-  return ImageEncoder::Encode(encoded_image, pixmap_,
+  std::vector<uint8_t> storage;
+  const SkPixmap encoded = PersonaReadbackPixmap(pixmap_, &storage);
+  return ImageEncoder::Encode(encoded_image, encoded,
                               base::OptionalToPtr(hdr_metadata), mime_type,
                               quality);
 }
@@ -158,7 +203,9 @@
   Vector<unsigned char> result;
   std::optional<skhdr::Metadata> hdr_metadata =
       ImageEncoderUtils::ToSkHdrMetadata(hdr_metadata_);
-  if (!ImageEncoder::Encode(&result, pixmap_, base::OptionalToPtr(hdr_metadata),
+  std::vector<uint8_t> storage;
+  const SkPixmap encoded = PersonaReadbackPixmap(pixmap_, &storage);
+  if (!ImageEncoder::Encode(&result, encoded, base::OptionalToPtr(hdr_metadata),
                             mime_type, quality)) {
     return "data:,";
   }
