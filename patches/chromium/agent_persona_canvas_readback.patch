+
+void PerturbReadbackImageData(ImageData* image_data) {
+  if (!image_data)
+    return;
+  SkPixmap pixmap = image_data->GetSkPixmap();
+  if (!pixmap.addr())
+    return;
+  PerturbCanvasBytes(static_cast<uint8_t*>(pixmap.writable_addr()),
+                     pixmap.computeByteSize());
