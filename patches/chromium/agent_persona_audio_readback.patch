 namespace blink {
 
+
+uint32_t AgentAudioHash() {
+  const std::string seed =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-audio-seed");
+  uint32_t hash = 2166136261u;
+  for (unsigned char c : seed)
+    hash = (hash ^ c) * 16777619u;
+  return hash;
+}
+
+bool AgentAudioEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "electron-agent-audio-seed");
+}
+
+void PerturbAnalyserFloats(DOMFloat32Array* array) {
+  if (!AgentAudioEnabled() || !array)
+    return;
+  const uint32_t hash = AgentAudioHash();
+  base::span<float> samples = array->AsSpan();
+  for (size_t i = 0; i < samples.size(); i += 64) {
+    uint32_t bits = 0;
+    memcpy(&bits, &samples[i], sizeof(bits));
+    uint32_t mixed = (hash ^ static_cast<uint32_t>(i) ^ bits) * 0x9E3779B1u;
+    samples[i] += ((mixed & 1u) ? 1.0f : -1.0f) * 1.0e-7f;
+  }
+}
+
+void PerturbAnalyserBytes(DOMUint8Array* array) {
+  if (!AgentAudioEnabled() || !array)
+    return;
+  const uint32_t hash = AgentAudioHash();
+  base::span<uint8_t> bytes = array->AsSpan();
+  for (size_t i = 0; i < bytes.size(); i += 64) {
+    uint32_t mixed = (hash ^ static_cast<uint32_t>(i) ^ bytes[i]) * 0x9E3779B1u;
+    if (mixed & 1u) {
+      bytes[i] = bytes[i] == 255 ? static_cast<uint8_t>(254)
+                                 : static_cast<uint8_t>(bytes[i] + 1);
+    } else {
+      bytes[i] = bytes[i] == 0 ? static_cast<uint8_t>(1)
+                               : static_cast<uint8_t>(bytes[i] - 1);
+    }
+  }
+}
+
