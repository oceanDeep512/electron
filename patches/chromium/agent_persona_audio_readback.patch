From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Electron Agent Runtime <agent-runtime@electron.local>
Date: Wed, 11 Nov 2026 19:40:00 +0000
Subject: [electron] perturb offline audio results and analyser readings

An agent persona passes these values on the renderer command line. The
offline result is perturbed once per AudioBuffer. Analyser readings are
perturbed on the output arrays. Nothing here is compiled in this change.

diff --git a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
--- a/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
+++ b/third_party/blink/renderer/modules/webaudio/offline_audio_context.cc
@@ -25,8 +25,11 @@
 
 #include "third_party/blink/renderer/modules/webaudio/offline_audio_context.h"
 
+#include <cstring>
 #include <optional>
 
+#include "base/command_line.h"
+
 #include "base/metrics/histogram_functions.h"
 #include "base/metrics/histogram_macros.h"
 #include "base/numerics/safe_conversions.h"
@@ -560,6 +563,41 @@
   return promise;
 }
 
+
+uint32_t AgentAudioHash() {
+  const std::string seed =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-audio-seed");
+  uint32_t hash = 2166136261u;
+  for (unsigned char c : seed)
+    hash = (hash ^ c) * 16777619u;
+  return hash;
+}
+
+bool AgentAudioEnabled() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      "electron-agent-audio-seed");
+}
+
+void PerturbOfflineResult(AudioBuffer* buffer) {
+  if (!AgentAudioEnabled() || !buffer || buffer->AgentReadbackPerturbed())
+    return;
+  buffer->MarkAgentReadbackPerturbed();
+  const uint32_t hash = AgentAudioHash();
+  for (unsigned channel = 0; channel < buffer->numberOfChannels(); ++channel) {
+    NotShared<DOMFloat32Array> data = buffer->getChannelData(channel);
+    if (!data)
+      continue;
+    base::span<float> samples = data.Get()->AsSpan();
+    for (size_t i = 0; i < samples.size(); i += 64) {
+      uint32_t bits = 0;
+      memcpy(&bits, &samples[i], sizeof(bits));
+      uint32_t mixed = (hash ^ static_cast<uint32_t>(i) ^ bits) * 0x9E3779B1u;
+      samples[i] += ((mixed & 1u) ? 1.0f : -1.0f) * 1.0e-7f;
+    }
+  }
+}
+
 void OfflineAudioContext::OnChunkRendered() {
   DCHECK(IsMainThread());
 
@@ -578,6 +616,7 @@
   Member<AudioBuffer> rendered_buffer = pending_render_targets_.front();
 
   CHECK(rendered_buffer);
+  PerturbOfflineResult(rendered_buffer.Get());
   // Keep the target queued across `Resolve()` so synchronous thenable getters
   // can enqueue more chunks without starting a duplicate render.
   resolver->Resolve(rendered_buffer.Get());
