 namespace blink {
+namespace {
+
+bool AgentFontCoreEnabled() {
+  return base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+             "electron-agent-font-policy") == "core";
+}
+
+bool AgentCoreFontFamily(const String& family) {
+  if (family.empty())
+    return false;
+  // Published core names only. Generic families never reach this helper.
+  // Host metrics still apply when one of these families is installed.
+  const char* const kNames[] = {"arial", "courier new", "georgia",
+                                "times new roman", "trebuchet ms", "verdana"};
+  const std::string folded = base::ToLowerASCII(family.Utf8());
+  for (const char* name : kNames) {
+    if (folded == name)
+      return true;
+  }
+  return false;
+}
+
+}  // namespace
 
 const char kColorEmojiLocale[] = "und-Zsye";
 const char kMonoEmojiLocale[] = "und-Zsym";
