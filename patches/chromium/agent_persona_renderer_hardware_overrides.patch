From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Electron Agent Runtime <agent-runtime@electron.local>
Date: Wed, 11 Nov 2026 18:20:00 +0000
Subject: [electron] override hardwareConcurrency and deviceMemory per renderer

A renderer command-line switch supplies the agent persona values. The
browser process does not read them, and the testing device-memory setter
is not used.

diff --git a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
--- a/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
+++ b/third_party/blink/renderer/core/frame/navigator_concurrent_hardware.cc
@@ -4,11 +4,23 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_concurrent_hardware.h"
 
+#include "base/command_line.h"
+#include "base/strings/string_number_conversions.h"
 #include "base/system/sys_info.h"
 
 namespace blink {
 
 unsigned NavigatorConcurrentHardware::hardwareConcurrency() const {
+  // Electron agent persona. The switch is added only to that session's
+  // renderer processes. It is not the testing SysInfo override.
+  const std::string override_value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-hardware-concurrency");
+  unsigned parsed = 0;
+  if (!override_value.empty() && base::StringToUint(override_value, &parsed) &&
+      parsed >= 1 && parsed <= 1024) {
+    return parsed;
+  }
   return static_cast<unsigned>(base::SysInfo::NumberOfProcessors());
 }
 
diff --git a/third_party/blink/renderer/core/frame/navigator_device_memory.cc b/third_party/blink/renderer/core/frame/navigator_device_memory.cc
--- a/third_party/blink/renderer/core/frame/navigator_device_memory.cc
+++ b/third_party/blink/renderer/core/frame/navigator_device_memory.cc
@@ -4,6 +4,7 @@
 
 #include "third_party/blink/renderer/core/frame/navigator_device_memory.h"
 
+#include "base/command_line.h"
 #include "third_party/blink/public/common/device_memory/approximated_device_memory.h"
 #include "third_party/blink/public/mojom/use_counter/metrics/web_feature.mojom-shared.h"
 #include "third_party/blink/renderer/core/dom/document.h"
@@ -12,6 +13,29 @@
 namespace blink {
 
 float NavigatorDeviceMemory::deviceMemory() const {
+  // Electron agent persona. The switch is added only to that session's
+  // renderer processes. SetPhysicalMemoryMBForTesting is not used.
+  const std::string override_value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-device-memory");
+  if (override_value == "0.25")
+    return 0.25f;
+  if (override_value == "0.5")
+    return 0.5f;
+  if (override_value == "1")
+    return 1.0f;
+  if (override_value == "2")
+    return 2.0f;
+  if (override_value == "4")
+    return 4.0f;
+  if (override_value == "8")
+    return 8.0f;
+  if (override_value == "16")
+    return 16.0f;
+  if (override_value == "32")
+    return 32.0f;
+  if (override_value == "64")
+    return 64.0f;
   return ApproximatedDeviceMemory::GetApproximatedDeviceMemory();
 }
 
