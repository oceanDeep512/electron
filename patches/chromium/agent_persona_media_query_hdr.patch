From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Electron Agent Runtime <agent-runtime@electron.local>
Date: Wed, 11 Nov 2026 20:20:00 +0000
Subject: [electron] follow persona HDR and color-index in media queries

electron-agent-hdr overrides dynamic-range and video-dynamic-range.
electron-agent-color-index overrides the hardcoded color-index of 0. Both
switches are absent unless the persona sets the field. This patch is applied
after agent_persona_media_query_screen.patch. Nothing here is compiled.

diff --git a/third_party/blink/renderer/core/css/media_values.cc b/third_party/blink/renderer/core/css/media_values.cc
--- a/third_party/blink/renderer/core/css/media_values.cc
+++ b/third_party/blink/renderer/core/css/media_values.cc
@@ -262,6 +262,16 @@
 bool MediaValues::CalculateDeviceSupportsHDR(LocalFrame* frame) {
   DCHECK(frame);
   DCHECK(frame->GetPage());
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (command_line->HasSwitch("electron-agent-hdr")) {
+    const std::string value =
+        command_line->GetSwitchValueASCII("electron-agent-hdr");
+    if (value == "1")
+      return true;
+    if (value == "0")
+      return false;
+  }
   return frame->GetPage()
       ->GetChromeClient()
       .GetScreenInfo(*frame)
diff --git a/third_party/blink/renderer/core/css/media_query_evaluator.cc b/third_party/blink/renderer/core/css/media_query_evaluator.cc
--- a/third_party/blink/renderer/core/css/media_query_evaluator.cc
+++ b/third_party/blink/renderer/core/css/media_query_evaluator.cc
@@ -29,8 +29,10 @@
 
 #include "third_party/blink/renderer/core/css/media_query_evaluator.h"
 
+#include "base/command_line.h"
 #include "base/functional/function_ref.h"
 #include "base/notreached.h"
+#include "base/strings/string_number_conversions.h"
 #include "third_party/blink/public/common/css/forced_colors.h"
 #include "third_party/blink/public/common/css/navigation_controls.h"
 #include "third_party/blink/public/common/css/scripting.h"
@@ -344,21 +346,33 @@
   return bits_per_component != 0;
 }
 
+static int AgentColorIndex() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch("electron-agent-color-index"))
+    return 0;
+  int parsed = 0;
+  if (!base::StringToInt(
+          command_line->GetSwitchValueASCII("electron-agent-color-index"),
+          &parsed) ||
+      parsed < 0) {
+    return 0;
+  }
+  return parsed;
+}
+
 static bool ColorIndexMediaFeatureEval(const MediaQueryExpValue& value,
                                        MediaQueryOperator op,
                                        const MediaValues& media_values) {
-  // FIXME: We currently assume that we do not support indexed displays, as it
-  // is unknown how to retrieve the information if the display mode is indexed.
-  // This matches Firefox.
-  if (!value.IsValid()) {
-    return false;
-  }
+  // Without the persona switch this stays 0, matching Blink's indexed-display
+  // assumption. A set switch is the lookup-table size the persona claims.
+  const int color_index = AgentColorIndex();
+  if (!value.IsValid())
+    return color_index != 0;
 
-  // Acording to spec, if the device does not use a color lookup table, the
-  // value is zero.
   float number;
   return NumberValue(value, number, media_values) &&
-         CompareValue(0, ClampTo<int>(number), op);
+         CompareValue(color_index, ClampTo<int>(number), op);
 }
 
 static bool MonochromeMediaFeatureEval(const MediaQueryExpValue& value,
