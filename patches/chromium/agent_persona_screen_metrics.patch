From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Electron Agent Runtime <agent-runtime@electron.local>
Date: Wed, 11 Nov 2026 19:10:00 +0000
Subject: [electron] override screen metrics without touching layout scale

An agent persona passes these values on the renderer command line. The
switches are absent unless that renderer belongs to a persona session, so
other processes keep Chromium's behavior. Nothing here is compiled in this
change.

diff --git a/third_party/blink/renderer/core/frame/screen.cc b/third_party/blink/renderer/core/frame/screen.cc
--- a/third_party/blink/renderer/core/frame/screen.cc
+++ b/third_party/blink/renderer/core/frame/screen.cc
@@ -28,7 +28,13 @@
 
 #include "third_party/blink/renderer/core/frame/screen.h"
 
+#include <optional>
+#include <vector>
+
+#include "base/command_line.h"
 #include "base/numerics/safe_conversions.h"
+#include "base/strings/string_number_conversions.h"
+#include "base/strings/string_split.h"
 #include "services/network/public/mojom/permissions_policy/permissions_policy_feature.mojom-blink.h"
 #include "third_party/blink/renderer/core/dom/document.h"
 #include "third_party/blink/renderer/core/event_target_names.h"
@@ -41,6 +47,46 @@
 
 namespace blink {
 
+namespace {
+
+struct AgentScreenOverride {
+  int width;
+  int height;
+  int avail_width;
+  int avail_height;
+  int depth;
+  float scale;
+};
+
+std::optional<AgentScreenOverride> ReadAgentScreenOverride() {
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-screen");
+  if (value.empty())
+    return std::nullopt;
+  std::vector<std::string> parts = base::SplitString(
+      value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+  if (parts.size() != 6)
+    return std::nullopt;
+  AgentScreenOverride screen;
+  double scale = 0;
+  if (!base::StringToInt(parts[0], &screen.width) ||
+      !base::StringToInt(parts[1], &screen.height) ||
+      !base::StringToInt(parts[2], &screen.avail_width) ||
+      !base::StringToInt(parts[3], &screen.avail_height) ||
+      !base::StringToInt(parts[4], &screen.depth) ||
+      !base::StringToDouble(parts[5], &scale) || screen.width < 1 ||
+      screen.height < 1 || screen.avail_width < 1 || screen.avail_height < 1 ||
+      scale <= 0) {
+    return std::nullopt;
+  }
+  screen.scale = static_cast<float>(scale);
+  return screen;
+}
+
+}  // namespace
+
+
 Screen::Screen(LocalDOMWindow* window, int64_t display_id)
     : ExecutionContextClient(window), display_id_(display_id) {}
 
