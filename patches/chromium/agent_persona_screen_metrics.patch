@@ -1963,6 +1969,19 @@
   if (!GetFrame()) {
     return 0.0;
   }
+  // The frame scale used by layout and OSR stays on DevicePixelRatio().
+  const std::string value =
+      base::CommandLine::ForCurrentProcess()->GetSwitchValueASCII(
+          "electron-agent-screen");
+  if (!value.empty()) {
+    std::vector<std::string> parts = base::SplitString(
+        value, ",", base::TRIM_WHITESPACE, base::SPLIT_WANT_ALL);
+    double scale = 0;
+    if (parts.size() == 6 && base::StringToDouble(parts[5], &scale) &&
+        scale > 0) {
+      return scale;
+    }
+  }
 
   return GetFrame()->DevicePixelRatio();
